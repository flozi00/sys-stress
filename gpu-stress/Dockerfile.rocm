# Triton GPU stress test - AMD / ROCm image.
# The ROCm PyTorch image ships a ROCm enabled PyTorch + Triton, so the very same
# gpu_stress.py runs unchanged on AMD GPUs.
FROM rocm/pytorch:rocm6.2_ubuntu22.04_py3.10_pytorch_release_2.3.0

WORKDIR /workspace/gpu-stress
COPY gpu_stress.py .

ENTRYPOINT ["python3", "gpu_stress.py"]
CMD ["--duration", "120"]
