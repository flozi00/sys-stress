# Triton GPU stress test - AMD / ROCm image.
# The ROCm PyTorch image ships a ROCm enabled PyTorch + Triton, so the very same
# gpu_stress.py runs unchanged on AMD GPUs.
#
# Use a ROCm >= 6.3 image so that kernels for recent AMD architectures are
# included (gfx1201 for RDNA 4, gfx942 for Instinct MI300X/MI325, etc.).
# ROCm 6.2 and older images lack these builds and fail with
# "HIP error: no kernel image is available for execution on the device".
FROM rocm/pytorch:rocm6.4.2_ubuntu24.04_py3.12_pytorch_release_2.6.0

WORKDIR /workspace/gpu-stress
COPY gpu_stress.py .

ENTRYPOINT ["python3", "gpu_stress.py"]
CMD ["--duration", "120"]
